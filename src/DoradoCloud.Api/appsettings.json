{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "http://localhost:5080/",
    "DisableTransportSecurity": false,
    "SqlitePath": "dorado-cloud-auth.db",
    "UseDevelopmentCertificates": false,
    "Certificates": {
      "Path": "data/keys",
      "Password": ""
    }
  },
  "Identity": {
    "Security": {
      "PublicBaseUrl": "http://localhost:5080",
      "EmailVerificationTtlHours": 24,
      "PasswordResetTtlHours": 2,
      "RequireEmailVerification": false
    }
  },
  "Updates": {
    "SigningKeyPath": "data/keys/updates-signing.pem",
    "Admins": []
  },
  "Admin": {
    "Subjects": []
  },
  "Directory": {
    "CacheSeconds": 300,
    "PodcastIndex": {
      "BaseUrl": "https://api.podcastindex.org/",
      "ApiKey": "",
      "ApiSecret": "",
      "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)"
    },
    "RadioBrowser": {
      "BaseUrl": "https://de1.api.radio-browser.info/",
      "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
      "Enabled": true
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Catalog": {
    "MusicBrainzBaseUrl": "https://musicbrainz.org/",
    "CoverArtBaseUrl": "https://coverartarchive.org/",
    "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
    "MusicBrainzRateLimitMs": 1000,
    "CacheSeconds": 3600
  },
  "Providers": {
    "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
    "FanartTv": { "ApiKey": "" },
    "TheAudioDb": { "ApiKey": "" },
    "Discogs": { "Token": "" }
  },
  "Artwork": {
    "CoverArtBaseUrl": "https://coverartarchive.org/",
    "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
    "AllowedHosts": ["coverartarchive.org", "archive.org", "fanart.tv", "theaudiodb.com", "discogs.com", "wikimedia.org", "wikipedia.org"],
    "RateLimitMs": 200,
    "MaxBytes": 12582912
  },
  "Redis": {
    "Configuration": ""
  },
  "Resources": {
    "CorpusRoot": "",
    "PublicBaseUrl": "http://resources.zune.net",
    "Devices": []
  },
  "Tiles": {
    "CorpusRoot": ""
  },
  "Apps": {
    "CorpusRoot": "",
    "PackageExtension": ".zcp",
    "MaxPackages": 2000
  },
  "Tuners": {
    "CorpusRoot": ""
  },
  "Legacy": {
    "Login": {
      "Enabled": false,
      "PublicBaseUrl": "https://login.zune.net"
    },
    "Session": {
      "TtlHours": 720
    }
  },
  "Media": {
    "Enabled": false,
    "AllowedLicenses": [ "PD", "CC0", "CC-BY", "CC-BY-SA", "CC-BY-4.0", "CC-BY-SA-4.0" ],
    "MaxBytes": 26214400
  },
  "Embedding": {
    "Enabled": false,
    "UsePgvector": false,
    "Dimensions": 1536
  },
  "Otel": {
    "Endpoint": ""
  },
  "Storage": {
    "Provider": "local",
    "LocalRoot": "data/objects",
    "S3": {
      "ServiceUrl": "",
      "Bucket": "dorado-cloud",
      "AccessKey": "",
      "SecretKey": ""
    }
  }
}
