{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "http://localhost:5080/",
    "DisableTransportSecurity": false,
    "SqlitePath": "dorado-cloud-auth.db",
    "UseDevelopmentCertificates": false,
    "Certificates": {
      "Path": "data/keys",
      "Password": ""
    }
  },
  "Updates": {
    "SigningKeyPath": "data/keys/updates-signing.pem",
    "Admins": []
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Redis": {
    "Configuration": ""
  },
  "Otel": {
    "Endpoint": ""
  },
  "Storage": {
    "Provider": "local",
    "LocalRoot": "data/objects",
    "S3": {
      "ServiceUrl": "",
      "Bucket": "dorado-cloud",
      "AccessKey": "",
      "SecretKey": ""
    }
  }
}
