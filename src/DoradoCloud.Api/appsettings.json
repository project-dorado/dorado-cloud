{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "http://localhost:5080/",
    "DisableTransportSecurity": false,
    "SqlitePath": "dorado-cloud-auth.db",
    "UseDevelopmentCertificates": false,
    "Certificates": {
      "Path": "data/keys",
      "Password": ""
    }
  },
  "Updates": {
    "SigningKeyPath": "data/keys/updates-signing.pem",
    "Admins": []
  },
  "Admin": {
    "Subjects": []
  },
  "Directory": {
    "CacheSeconds": 300,
    "PodcastIndex": {
      "BaseUrl": "https://api.podcastindex.org/",
      "ApiKey": "",
      "ApiSecret": "",
      "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)"
    },
    "RadioBrowser": {
      "BaseUrl": "https://de1.api.radio-browser.info/",
      "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
      "Enabled": true
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Catalog": {
    "MusicBrainzBaseUrl": "https://musicbrainz.org/",
    "CoverArtBaseUrl": "https://coverartarchive.org/",
    "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
    "MusicBrainzRateLimitMs": 1000,
    "CacheSeconds": 3600
  },
  "Artwork": {
    "CoverArtBaseUrl": "https://coverartarchive.org/",
    "UserAgent": "DoradoCloud/0.1 (+https://github.com/project-dorado/dorado-cloud)",
    "AllowedHosts": ["coverartarchive.org", "archive.org", "fanart.tv", "theaudiodb.com", "wikimedia.org", "wikipedia.org"],
    "RateLimitMs": 200,
    "MaxBytes": 12582912
  },
  "Redis": {
    "Configuration": ""
  },
  "Otel": {
    "Endpoint": ""
  },
  "Storage": {
    "Provider": "local",
    "LocalRoot": "data/objects",
    "S3": {
      "ServiceUrl": "",
      "Bucket": "dorado-cloud",
      "AccessKey": "",
      "SecretKey": ""
    }
  }
}
