# Dorado Cloud — copy to `.env` and fill in strong values.

# PostgreSQL password (required)
POSTGRES_PASSWORD=change-me-postgres

# MinIO (S3-compatible object store) credentials (required)
MINIO_ROOT_USER=dorado
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=dorado-cloud

# Public issuer URL. For local HTTP testing keep the default; for TLS put the
# gateway's real https URL here and set AUTH_DISABLE_TLS=false.
AUTH_ISSUER=http://localhost:5088/
# Disable TLS enforcement on OpenIddict. Defaults to true in the compose file so
# the stack works over plain HTTP locally; set false for any public deployment.
AUTH_DISABLE_TLS=true

# Optional: browser CORS allowlist (comma-separated). Empty ⇒ permissive only in
# Development; same-origin otherwise.
CORS_ALLOWED_ORIGINS=

# Optional: auth endpoint rate limit, requests/minute per IP (default 60)
AUTH_RATE_LIMIT_PER_MINUTE=60

# Optional OTLP endpoint for traces/metrics
OTEL_ENDPOINT=

# Legacy resources.zune.net: host directory holding firmware baseline CABs.
# External and untracked — mounted read-only at /corpus. Leave RESOURCES_CORPUS_ROOT
# empty to disable firmware serving (the service then fails closed with 404).
RESOURCES_CORPUS_HOST=./corpus
RESOURCES_CORPUS_ROOT=/corpus
